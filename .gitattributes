# Normalize source files across Windows and WSL
* text=auto
*.sh text eol=lf
*.bash text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.c text eol=lf
*.h text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Explicit binary formats
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.gif binary
*.webp binary
*.pdf binary
